{
  "expo": {
    "name": "Place Brokers",
    "slug": "expo-pi4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icone.png",
    "scheme": "placebrokers",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08152b",
        "foregroundImage": "./assets/icone.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arthurmssteam.expopi4",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08152b",
          "image": "./assets/icone.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#e9ad5a"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5f42591d-634e-4e46-bb8a-439091cdf104"
      }
    },
    "owner": "arthurmss-team",
    "backgroundColor": "#08152b",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5f42591d-634e-4e46-bb8a-439091cdf104"
    },
    "ios": {}
  }
}
